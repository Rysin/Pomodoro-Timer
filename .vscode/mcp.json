{
  "inputs": [
    {
      "type": "promptString",
      "id": "jira-url",
      "description": "Atlassian Cloud Jira URL",
      "password": false
    },
    {
      "type": "promptString",
      "id": "jira-username",
      "description": "Atlassian account email",
      "password": false
    },
    {
      "type": "promptString",
      "id": "jira-api-token",
      "description": "Atlassian API token",
      "password": true
    }
  ],
  "servers": {
    "atlassian": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "${input:jira-url}",
        "JIRA_USERNAME": "${input:jira-username}",
        "JIRA_API_TOKEN": "${input:jira-api-token}"
      }
    }
  }
}
